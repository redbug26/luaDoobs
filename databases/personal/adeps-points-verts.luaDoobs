-- ADEPS Points verts
-- Open this file in Doobs to create a database with all ADEPS walking events.
-- Its read-only linked library uses the public ODWB JSON export, without a key.
-- Archives and cancellations are included. Dates, contacts, coordinates, services and GPX
-- links are mapped to typed fields. No file, credential or existing library is needed.
-- The refresh interval is configurable; the default is 360 minutes, plus refresh on opening.

-- French translations; English is the source language.
doobs.trInit("fr", {
  ["ADEPS Points verts"] = "Points verts ADEPS",
  ["All ADEPS walking events, including archives and cancellations. The linked library refreshes on opening and every six hours by default."] = "Tous les rendez-vous ADEPS, archives et annulations comprises. La bibliothèque liée est actualisée à l’ouverture et toutes les six heures par défaut.",
  ["Refresh interval (minutes)"] = "Intervalle de rafraîchissement (minutes)",
  ["0 disables periodic refresh; the library still refreshes on opening."] = "0 désactive le rafraîchissement périodique ; la bibliothèque reste actualisée à l’ouverture.",
  ["The refresh interval must be a non-negative integer."] = "L’intervalle de rafraîchissement doit être un entier positif ou nul.",
  ["Cancelled"] = "Annulés",
  ["Modified"] = "Modifiés",
  ["Accessible walks"] = "Marches accessibles",
  ["Event"] = "Rendez-vous",
  ["Location"] = "Lieu",
  ["Contact"] = "Contact",
  ["Routes and services"] = "Parcours et services",
  ["Identifier"] = "Identifiant",
  ["ADEPS identifier"] = "Identifiant ADEPS",
  ["Activity"] = "Activité",
  ["Status"] = "Statut",
  ["Locality"] = "Localité",
  ["Municipality"] = "Commune",
  ["Meeting place"] = "Rendez-vous",
  ["Meeting information"] = "Informations rendez-vous",
  ["IGN map"] = "Carte IGN",
  ["Railway station"] = "Gare",
  ["Organizer"] = "Organisateur",
  ["Contact last name"] = "Nom du contact",
  ["Contact first name"] = "Prénom du contact",
  ["Phone"] = "Téléphone",
  ["Reduced mobility access"] = "Accessible PMR",
  ["Strollers"] = "Poussettes",
  ["Orienteering"] = "Orientation",
  ["Guided walk"] = "Balade guidée",
  ["Cycling"] = "Vélo",
  ["Mountain biking"] = "VTT",
  ["Refreshments"] = "Ravitaillement",
  ["GPX tracks"] = "Traces GPX",
})
local T = doobs.tr

-- Kept verbatim so approving this file also approves its linked source.
-- This script runs independently and registers its own message translations.
local ADEPS_SCRIPT = [==[
-- ADEPS walking events: public ODWB JSON export.
doobs.trInit("fr", {
  ["Cannot read the ADEPS walking events. Try again later. %s"] = "Impossible de lire les points verts ADEPS. Réessayez plus tard. %s",
  ["ADEPS: the JSON export must be a list."] = "ADEPS : l’export JSON doit être une liste.",
  ["ADEPS: unexpected export format; refresh stopped."] = "ADEPS : format d’export inattendu ; actualisation interrompue.",
  ["ADEPS: missing row in the export; refresh stopped."] = "ADEPS : ligne manquante dans l’export ; actualisation interrompue.",
  ["ADEPS: event without identifier or walk code."] = "ADEPS : rendez-vous sans identifiant ou code de point vert.",
  ["ADEPS: duplicate identifier in the export: %s"] = "ADEPS : identifiant en double dans l’export : %s",
})
local T = doobs.tr

local SOURCE = "https://www.odwb.be/api/explore/v2.1/catalog/datasets/points-verts-de-ladeps/exports/json"

local function text(value)
  if type(value) ~= "string" then return nil end
  local clean = value:match("^%s*(.-)%s*$")
  if clean ~= "" then return clean end
end

local function number(value)
  if type(value) ~= "number" and type(value) ~= "string" then return nil end
  local n = tonumber(value)
  if n and n == n and n ~= math.huge and n ~= -math.huge then return n end
end

local function yesno(value)
  if type(value) ~= "string" then return nil end
  value = value:match("^%s*(.-)%s*$"):lower()
  if value == "oui" then return true end
  if value == "non" then return false end
  -- A missing or unknown value stays absent rather than becoming “No”.
end

local function position(row)
  local point = type(row.geopoint) == "table" and row.geopoint or {}
  local lat = number(point.lat) or number(row.latitude)
  local lon = number(point.lon) or number(row.longitude)
  if lat and lon and lat >= -90 and lat <= 90 and lon >= -180 and lon <= 180 then
    return tostring(lat) .. ", " .. tostring(lon), lat, lon
  end
end

local function traces(value)
  local raw = text(value)
  if not raw or raw == "[]" then return nil end
  local ok, items = pcall(doobs.json.decode, raw)
  if not ok or type(items) ~= "table" then return raw end
  local lines = {}
  for _, item in ipairs(items) do
    if type(item) == "table" then
      local url = text(item.fichier)
      if url and url:match("^https://") then
        lines[#lines + 1] = (text(item.titre) or "GPX") .. "\n" .. url
      end
    end
  end
  if #lines > 0 then return table.concat(lines, "\n\n") end
  -- Keep the metadata if the trace format changes.
  if next(items) then return raw end
end

function fetch(ctx)
  local query = { lang = "fr", timezone = "Europe/Brussels" }
  local limit
  if ctx.sample then
    limit = number(ctx.limit)
    limit = limit and limit > 0 and math.max(1, math.floor(limit)) or 20
    -- The export accepts limit: a trial run only downloads a sample, in one request.
    query.limit = limit
  end

  -- One request for the whole export in normal mode: no limit and no date filter.
  local ok, rows = pcall(doobs.http.getJSON, SOURCE, { query = query, timeout = 120 })
  if not ok then
    error(string.format(T("Cannot read the ADEPS walking events. Try again later. %s"), tostring(rows)))
  end
  if type(rows) ~= "table" then error(T("ADEPS: the JSON export must be a list.")) end
  local count = 0
  for key, row in pairs(rows) do
    if type(key) ~= "number" or key < 1 or key % 1 ~= 0 or type(row) ~= "table" then
      error(T("ADEPS: unexpected export format; refresh stopped."))
    end
    count = count + 1
  end
  for i = 1, count do
    if type(rows[i]) ~= "table" then
      error(T("ADEPS: missing row in the export; refresh stopped."))
    end
  end

  local records, seen = {}, {}
  for _, row in ipairs(rows) do
    local sourceID = type(row.id) == "string" and text(row.id)
      or (type(row.id) == "number" and tostring(row.id))
    local code = text(row.ndeg_pv)
    if not sourceID or not code then
      error(T("ADEPS: event without identifier or walk code."))
    end
    -- The export reuses some ids for several walks: the code tells them apart.
    -- Neither the date nor the place is part of the key: a correction keeps them linked.
    local id = sourceID .. ":" .. code
    if seen[id] then error(string.format(T("ADEPS: duplicate identifier in the export: %s"), id)) end
    seen[id] = true

    local location, lat, lon = position(row)
    records[#records + 1] = {
      id = id,
      source_id = sourceID,
      walk_code = code,
      date = text(row.date),
      activity = text(row.activite),
      status = text(row.statut),
      locality = text(row.localite),
      municipality = text(row.entite),
      province = text(row.province),
      meeting_place = text(row.lieu_de_rendez_vous),
      meeting_info = text(row.infos_rendez_vous),
      position = location,
      latitude = lat,
      longitude = lon,
      ign_map = text(row.ign),
      station = text(row.gare),
      organizer = text(row.groupement),
      contact_last_name = text(row.nom),
      contact_first_name = text(row.prenom),
      phone = text(row.gsm),
      distance_10km = yesno(row["10km"]),
      distance_15km = yesno(row["15km"]),
      accessible = yesno(row.pmr),
      strollers = yesno(row.poussettes),
      orienteering = yesno(row.orientation),
      guided_walk = yesno(row.balade_guidee),
      cycling = yesno(row.velo),
      mountain_biking = yesno(row.vtt),
      refreshments = yesno(row.ravitaillement),
      bewapp = yesno(row.bewapp),
      adep_health = yesno(row.adep_sante),
      gpx = traces(row.traces_gpx),
    }
    if limit and #records >= limit then break end
  end
  -- Any error goes back to Doobs, which then keeps the last valid cache.
  return records
end
]==]

function parameters(ctx)
  local form = doobs.parameters(T("ADEPS Points verts"), {
    database = T("ADEPS Points verts"),
    message = T("All ADEPS walking events, including archives and cancellations. The linked library refreshes on opening and every six hours by default."),
  })
  form:addInteger("refresh", T("Refresh interval (minutes)"), {
    default = 360, required = true,
    help = T("0 disables periodic refresh; the library still refreshes on opening."),
  })
  return form
end

function import(ctx)
  local interval = ctx.params.refresh
  if interval == nil then interval = 360 end
  if type(interval) ~= "number" or interval < 0 or interval % 1 ~= 0 then
    error(T("The refresh interval must be a non-negative integer."))
  end
  local DATE, LOCALITY, STATUS = T("Date"), T("Locality"), T("Status")
  local POSITION, ORGANIZER = T("Position"), T("Organizer")
  local ACCESSIBLE = T("Reduced mobility access")

  local db = doobs.database()
  local events = db:addLinkedLibrary(T("ADEPS Points verts"), {
    kind = "lua", script = ADEPS_SCRIPT, key = "id",
    refresh = interval, refreshOnOpen = true,
    timeout = 120, maxRecords = 100000,
  }, { icon = "figure.hiking", color = "green" })

  -- Declare each field and its stable source key explicitly; no type inference is needed.
  events:addField(T("Identifier"), "text", { source = "id" })
  events:addField(T("ADEPS identifier"), "text", { source = "source_id" })
  events:addField(T("Point vert"), "text", { source = "walk_code" })
  events:addField(DATE, "date", { source = "date" })
  events:addField(T("Activity"), "text", { source = "activity" })
  events:addField(STATUS, "text", { source = "status" })
  events:addField(LOCALITY, "text", { source = "locality" })
  events:addField(T("Municipality"), "text", { source = "municipality" })
  events:addField(T("Province"), "text", { source = "province" })
  events:addField(T("Meeting place"), "longtext", { source = "meeting_place" })
  events:addField(T("Meeting information"), "longtext", { source = "meeting_info" })
  events:addField(POSITION, "location", { source = "position" })
  events:addField(T("Latitude"), "decimal", { source = "latitude" })
  events:addField(T("Longitude"), "decimal", { source = "longitude" })
  events:addField(T("IGN map"), "text", { source = "ign_map" })
  events:addField(T("Railway station"), "longtext", { source = "station" })
  events:addField(ORGANIZER, "text", { source = "organizer" })
  events:addField(T("Contact last name"), "text", { source = "contact_last_name" })
  events:addField(T("Contact first name"), "text", { source = "contact_first_name" })
  events:addField(T("Phone"), "phone", { source = "phone" })
  events:addField(T("10 km"), "boolean", { source = "distance_10km" })
  events:addField(T("15 km"), "boolean", { source = "distance_15km" })
  events:addField(ACCESSIBLE, "boolean", { source = "accessible" })
  events:addField(T("Strollers"), "boolean", { source = "strollers" })
  events:addField(T("Orienteering"), "boolean", { source = "orienteering" })
  events:addField(T("Guided walk"), "boolean", { source = "guided_walk" })
  events:addField(T("Cycling"), "boolean", { source = "cycling" })
  events:addField(T("Mountain biking"), "boolean", { source = "mountain_biking" })
  events:addField(T("Refreshments"), "boolean", { source = "refreshments" })
  events:addField(T("Be WaPP"), "boolean", { source = "bewapp" })
  events:addField(T("Adep Santé"), "boolean", { source = "adep_health" })
  events:addField(T("GPX tracks"), "longtext", { source = "gpx" })

  events:setTitle(LOCALITY)
  events:setSubtitle(DATE)
  events:setSort(DATE, LOCALITY)
  events:setView("table")
  events:hideFields(T("Identifier"), T("ADEPS identifier"), T("Latitude"), T("Longitude"))

  -- These comparison values are source data, kept verbatim in either interface language.
  events:addCollection(T("Cancelled"), { { STATUS, "=", "Annulé" } })
  events:addCollection(T("Modified"), { { STATUS, "=", "Modifié" } })
  events:addCollection(T("Accessible walks"), { { ACCESSIBLE, "=", true } })

  local form = events:defaultForm({ columns = 2, theme = "forest" })
  form:addSection(T("Event"), { LOCALITY, DATE, T("Point vert"), T("Activity"), STATUS, ORGANIZER })
  form:addSection(T("Location"), {
    T("Municipality"), T("Province"), T("Meeting place"), T("Meeting information"),
    POSITION, T("IGN map"), T("Railway station"),
  })
  form:addSection(T("Contact"), { T("Contact first name"), T("Contact last name"), T("Phone") })
  form:addSection(T("Routes and services"), {
    T("10 km"), T("15 km"), ACCESSIBLE, T("Strollers"), T("Orienteering"), T("Guided walk"),
    T("Cycling"), T("Mountain biking"), T("Refreshments"), T("Be WaPP"), T("Adep Santé"), T("GPX tracks"),
  })
  return db
end
